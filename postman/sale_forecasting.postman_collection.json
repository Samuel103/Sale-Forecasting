            "url": {
              "raw": "{{base_url}}/predict",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "predict"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422 : requête rejetée\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"Détails de validation présents\", function () {",
                  "    pm.expect(pm.response.json().detail).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
